{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "es5",
  "embeddedLanguageFormatting": "off",
  "quoteProps": "preserve",
  "ignorePatterns": [
    "frontend/src/locales/**",
    "frontend/src/__tests__/__snapshots__/**",
    "frontend/public/**",
    "static/**",
    "**/*.html",
    "**/*.css",
    "**/*.json",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml"
  ]
}
