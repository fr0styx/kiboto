{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "frontend/src/**/*.js",
    "frontend/src/types/*.d.ts"
  ],
  "exclude": [
    "frontend/src/__tests__/**"
  ]
}
