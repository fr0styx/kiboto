# Kiboto as the service of a machine that was set up for it (packaging/install.sh).
[Unit]
Description=Kiboto
Documentation=https://github.com/fr0styx/kiboto
# the pools first (kiboto-pools mounts what nothing else does), then Docker, so no app and no
# shared folder meets an empty folder
After=network-online.target local-fs.target zfs-mount.service kiboto-pools.service docker.service
Wants=network-online.target kiboto-pools.service

[Service]
Type=simple
Environment=DATA_DIR=/var/lib/kiboto
Environment=HOST_PROC=/proc
Environment=HOST_SYS=/sys
Environment=HOST_DEV=/dev
Environment=POOL_PATH=/mnt/storage
Environment=PORT=8082
Environment=PYTHONUNBUFFERED=1
# what the person changes goes here, so an update never overwrites it
EnvironmentFile=-/etc/kiboto/kiboto.env
WorkingDirectory=/opt/kiboto/current
ExecStart=/opt/kiboto/current/venv/bin/python -m backend.main
Restart=on-failure
RestartSec=3
# virtual machines are shut down cleanly when Kiboto stops
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
